generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String    @db.VarChar(255)
  author    String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  chapters  Chapter[]

  @@map("books")
}

model Chapter {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookId             String              @map("book_id") @db.Uuid
  number             Int
  title              String              @db.VarChar(255)
  tags               String[]
  status             ChapterStatus       @default(DRAFT)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  book               Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  rawNote            RawNote?
  structuredDocument StructuredDocument?

  @@unique([bookId, number])
  @@map("chapters")
}

enum ChapterStatus {
  DRAFT
  STRUCTURED
}

model RawNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId String   @unique @map("chapter_id") @db.Uuid
  content   String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("raw_notes")
}

model StructuredDocument {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId       String   @unique @map("chapter_id") @db.Uuid
  markdownContent String   @map("markdown_content") @db.Text
  frontmatter     Json     @db.JsonB
  generatedAt     DateTime @default(now()) @map("generated_at") @db.Timestamptz
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("structured_documents")
}
